# Public site URL used for sitemap, canonical URLs, Open Graph, and JSON-LD.
# Production: https://mapeditiongroup.com
# Vercel preview: https://map-edition-group-limited.vercel.app
NEXT_PUBLIC_SITE_URL=https://mapeditiongroup.com

# Google Search Console verification code (HTML tag method).
# In Search Console: Settings → Ownership verification → HTML tag → copy the content value only.
# Example: if the tag is <meta name="google-site-verification" content="abc123" />, set abc123 here.
GOOGLE_SITE_VERIFICATION=
